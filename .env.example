# Copy this file to .env and add your own API key.
# Default provider: Groq (OpenAI-compatible API)
LLM_API_KEY=put_your_real_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Competition admin PIN
ADMIN_PIN=2026

# Change this to a long random secret before public deployment.
ADMIN_SECRET=replace-with-a-long-random-secret
